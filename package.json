{
  "name": "mizuki-panel",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "vite build && vite build --config vite.server.config.ts",
    "start": "node scripts/run.mjs start",
    "probe:markdown": "tsx scripts/probe-markdown-renderer.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,mjs,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,mjs,json,html}\"",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^2.1.1",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "^9.14.0",
    "@uiw/react-codemirror": "^4.25.12",
    "github-slugger": "2.0.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "yaml": "2.9.0"
  }
}
